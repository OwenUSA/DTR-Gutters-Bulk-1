# --- Database: pick ONE of the two forms below ---

# PREFERRED. Discrete variables — the password is passed to the driver as-is,
# so characters like > # ? & @ need no escaping. Paste values exactly as
# Hostinger shows them. On Hostinger, DB_HOST is `localhost`.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u439538525_youruser
DB_PASSWORD=your-password-exactly-as-shown
DB_NAME=u439538525_yourdb

# FALLBACK. Single URI. Used only when no DB_* variables are set.
# Reserved characters in the password MUST be percent-encoded:
#   >  becomes %3E      #  becomes %23      @  becomes %40
#   /  becomes %2F      ?  becomes %3F      &  becomes %26
# A raw # also truncates the value when read from a .env file.
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# JWT signing key for the admin session cookie. 32+ chars.
SESSION_SECRET=replace-with-32+char-random-string

# Public site URL — drives sitemap, robots, canonical, OG/Twitter metadata.
# Must be the domain this app actually serves. No trailing slash.
SITE_URL=https://example.com

# Brand name shown in metadata / titles.
SITE_NAME=Dream Team Roofing & Gutters
