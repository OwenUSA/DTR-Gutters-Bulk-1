# Hostinger MySQL — use the internal hostname when the app runs on Hostinger.
# Example: mysql://u439538525_user:password@localhost:3306/u439538525_dbname
DATABASE_URL=mysql://user:password@host:3306/dbname

# JWT signing key for the admin session cookie. Generate a fresh 32+ char string.
SESSION_SECRET=replace-with-32+char-random-string

# Public site URL — drives sitemap, robots, canonical, OG/Twitter metadata.
# Use the bare domain once registered. No trailing slash.
SITE_URL=https://dreamteamguttersfl.com

# Brand name shown in metadata / titles.
SITE_NAME=Dream Team Roofing & Gutters
